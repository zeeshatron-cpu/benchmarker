# Copy this file to `.env` and paste your real keys after the = signs.
# `.env` is gitignored — it stays on your machine and is NEVER committed.
#
#   cp .env.example .env      (PowerShell:  Copy-Item .env.example .env)
#   # then edit .env and paste your keys
#
# The pipeline loads .env automatically on every run.

